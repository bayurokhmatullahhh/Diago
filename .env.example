# Copy this file to .env and add your own local configuration.
# Never commit .env or put real API keys in this template.
APP_NAME=Digital Operator
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Local database
DATABASE_URL=sqlite:///./data/digital_operator.db

# Frontend origins, comma-separated
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Exact domains you own or are explicitly authorized to assess, comma-separated.
# The passive website check is disabled when this allowlist is empty.
SECURITY_AUDIT_ALLOWED_HOSTS=

# AI task planner: tries the default provider, then configured fallbacks.
LLM_DEFAULT_PROVIDER=gemini
LLM_FALLBACK_PROVIDERS=
LLM_TIMEOUT_SECONDS=30

# Add provider API keys only to your ignored local .env file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Example local OpenAI-compatible provider (for example, Ollama)
OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# Telegram integration is not implemented yet.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
